generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserProfile{
    id String @id @default(uuid())
    name String
    age Int
    bio String?
    instruments String[]

    likes LikeArtist[]
    questions Question[]
    comments Comment[]
}

model Artist {
  id          String       @id @default(uuid())
  name        String
  description String?

  likedBy     LikeArtist[]
}

model LikeArtist {
  id        String      @id @default(uuid())

  user      UserProfile @relation(fields: [userId], references: [id])
  userId    String

  artist    Artist      @relation(fields: [artistId], references: [id])
  artistId  String

  @@unique([userId, artistId]) 
}

model Question {
  id              String   @id @default(uuid())
  userId          String
  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  title           String
  content         String
  attachments     String[]
  
  showUsername    Boolean  @default(true)
  category        PostCategory @default(QUESTION)
  
  comments        Comment[]

  @@index([userId])
}

model Comment {
  id              String   @id @default(uuid())
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  userId          String
  user            UserProfile @relation(fields: [userId], references: [id],onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  content         String
  attachments     String[]
  showUsername    Boolean  @default(true)

  @@index([userId])
  @@index([questionId])
}

enum PostCategory {
  QUESTION
  PLAY
  OTHER
}